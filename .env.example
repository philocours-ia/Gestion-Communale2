# URL canonique de l'application (confirmation e-mail et callbacks)
NEXT_PUBLIC_APP_URL=https://sygec-ia.vercel.app

# Supabase — valeurs publiques uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Moteur conversationnel OMNIA — Gemini 4 Hydrogen par défaut
MIA_PROVIDER=google
MIA_MODEL=gemini-4-hydrogen
GOOGLE_API_KEY=

# Surcharges facultatives par assistant. Si vide, MIA_MODEL s'applique.
MIA_MODEL_OMNIA=
MIA_MODEL_MIORA=
MIA_MODEL_MATHS=
MIA_MODEL_FELIX=
MIA_MODEL_MIA=
MIA_MODEL_RESEARCH=
MIA_MODEL_DOCUMENTS=
MIA_MODEL_ACCOUNTING=
MIA_MODEL_HISTORY=

# Recherche web (à connecter séparément)
MIA_WEB_SEARCH_PROVIDER=
MIA_WEB_SEARCH_API_KEY=
