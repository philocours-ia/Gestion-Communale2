# URL canonique de l'application (confirmation e-mail et callbacks)
NEXT_PUBLIC_APP_URL=https://sygec-ia.vercel.app

# Supabase — valeurs publiques uniquement côté navigateur
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Moteur conversationnel OMNIA — fournisseur par défaut : DeepSeek
# Obtenir une clé API depuis le compte DeepSeek, puis la stocker comme secret serveur dans Vercel.
MIA_PROVIDER=deepseek
MIA_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Fournisseurs alternatifs conservés pour les évolutions futures
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Recherche web (à connecter séparément)
MIA_WEB_SEARCH_PROVIDER=
MIA_WEB_SEARCH_API_KEY=
